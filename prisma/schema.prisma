generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  name         String?
  password     String
  role         String        @default("USER")
  transactions Transaction[]
  bookings    BookingSession[]
}

model Product {
  id              Int               @id @default(autoincrement())
  name            String
  price           Decimal           @db.Decimal(10, 2)
  createdAt       DateTime          @default(now())
  stock           Int
  description     String
  image           String
  transactionItem TransactionItem[]
  category        Category[]
}

model Category {
  id              Int               @id @default(autoincrement())
  name            String
  createdAt       DateTime          @default(now())
  description     String
  productId       Int
  image           String
  product         Product           @relation(fields: [productId], references: [id])
}

model Transaction {
  id        Int               @id @default(autoincrement())
  userId    Int
  total     Decimal           @db.Decimal(10, 2)
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id])
  items     TransactionItem[]
  bookings    BookingSession[]
}

model TransactionItem {
  id            Int         @id @default(autoincrement())
  transactionId Int
  productId     Int
  quantity      Int
  price         Decimal     @db.Decimal(10, 2)
  product       Product     @relation(fields: [productId], references: [id])
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  booking     BookingSession[]

  @@unique([transactionId, productId])
}



model Package {
  id          Int      @id @default(autoincrement())
  name        String   @unique // BASIC, PREMIUM, PLATINUM
  description String?
  price       Decimal  @db.Decimal(10, 2)
  durationMin Int      // duration in minutes

  bookings    BookingSession[]
}


model BookingSession {
  id            Int      @id @default(autoincrement())

  bookingDate   DateTime
  status        String   @default("PENDING") 
  notes         String?

  userId        Int
  packageId     Int
  transactionitemId   Int
  transactionId Int?     // optional until paid

  user        User        @relation(fields: [userId], references: [id])
  package     Package     @relation(fields: [packageId], references: [id])
  transaction Transaction? @relation(fields: [transactionId], references: [id])
  transactionItem TransactionItem   @relation(fields:[transactionitemId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([bookingDate])
}